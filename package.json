{
  "name": "dsh-connect-loomy",
  "displayName": "DSH Connect Loomy",
  "description": "把本机登录的 Loomy（讯飞办公助手）模型接入 DeepSeek Harness 模型选择器，并提供设置卡片与只读积分概览。",
  "version": "0.1.0",
  "author": {
    "name": "diudiu62",
    "url": "https://github.com/diudiu62"
  },
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "loomy",
    "iflytek",
    "model-provider"
  ],
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "screenshots.json"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-client-locale": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-settings-plugins": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-credentials": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-settings": ">=0.2.2-rc.1 <0.3.0-0",
    "@earendil-works/pi-ai": "^1.3.0",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-store": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.1",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.1",
    "@deepseek-ai/dsh-host-webserver": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.2-rc.1",
    "@deepseek-ai/dsh-settings": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "3.19.0",
    "@earendil-works/pi-ai": "1.5.2",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.31",
    "@types/react-dom": "^18.3.7",
    "jsdom": "25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('lib',{recursive:true,force:true})\" && tsdown",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "check": "pnpm run typecheck && pnpm run build && pnpm run test",
    "pretest": "pnpm run build",
    "prepack": "pnpm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "bin": {
    "dsh-connect-loomy": "lib/bin.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OWNER/dsh-connect-loomy.git"
  },
  "homepage": "https://github.com/OWNER/dsh-connect-loomy#readme",
  "bugs": {
    "url": "https://github.com/OWNER/dsh-connect-loomy/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
